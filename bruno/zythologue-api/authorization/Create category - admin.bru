meta {
  name: Create category - admin
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/categories
  body: json
  auth: none
}

body:json {
  {
    "name": "{{categoryName}}",
    "description": "Créée par le scénario d'autorisation"
  }
}

script:pre-request {
  // Nom unique à chaque run (la colonne name est UNIQUE)
  bru.setVar("categoryName", `Catégorie admin ${Date.now()}`);
}

script:post-response {
  bru.setVar("categoryId", res.body.id);
}

assert {
  res.status: eq 201
}
