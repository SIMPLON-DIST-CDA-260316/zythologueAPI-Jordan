meta {
  name: Register - weak password
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "lastName": "Faible",
    "firstName": "Paul",
    "email": "{{registerEmail}}",
    "birthDate": "1995-06-15",
    "password": "motdepasse123"
  }
}

assert {
  res.status: eq 400
}

script:pre-request {
  bru.setVar("registerEmail", `paul.faible+${Date.now()}@example.com`);
}

tests {
  test("un message par règle manquante", () => {
    expect(res.body.errors.fieldErrors.password).to.have.members([
      "Le mot de passe doit contenir au moins une majuscule",
      "Le mot de passe doit contenir au moins un caractère spécial",
    ]);
  });
}

docs {
  Assez long mais sans majuscule ni caractère spécial : chaque règle
  manquante remonte son propre message.
}
