meta {
  name: Login - unknown email
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "personne@example.com",
    "password": "Motdepasse123!"
  }
}

assert {
  res.status: eq 400
}

tests {
  test("message générique, pas de cookie", () => {
    expect(res.body.message).to.equal("Email ou mot de passe incorrect");
    expect(res.getHeader("set-cookie")).to.be.undefined;
  });
}

docs {
  Même réponse que "wrong password" : le message ne doit pas révéler
  si le compte existe. Le temps de réponse doit aussi être proche
  (faux hash vérifié côté service).
}
