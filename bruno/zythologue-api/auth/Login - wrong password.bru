meta {
  name: Login - wrong password
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "alice.dupont@example.com",
    "password": "mauvaismotdepasse"
  }
}

assert {
  res.status: eq 400
}

tests {
  test("message générique, pas de cookie", () => {
    expect(res.body.message).to.equal("Email ou mot de passe incorrect");
    expect(res.getHeader("set-cookie")).to.be.undefined;
  });
}

docs {
  Même réponse que "unknown email" : le message ne doit pas révéler
  si le compte existe.
}
