meta {
  name: Get beer logs - invalid query
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/beer-logs?foo=1
  body: none
  auth: none
}

docs {
  Clé inconnue refusée par le middleware validate (schéma strict), avec le
  même format d'erreur que les autres routes.
  Nécessite le cookie admin (authorization/Login admin).
}

assert {
  res.status: eq 400
  res.body.message: eq "Données invalides"
  res.body.errors: isDefined
}
